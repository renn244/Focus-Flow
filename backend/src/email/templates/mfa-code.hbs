<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Your FocusFlow sign-in code</title>
    </head>
    <body style="margin:0;padding:0;background:#08142d;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#08142d;padding:40px 16px;">
            <tr>
                <td align="center">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:480px;background:#ffffff;border-radius:12px;">
                        <tr>
                            <td style="padding:32px 32px 8px;">
                                <p style="margin:0 0 24px;font-size:18px;font-weight:600;color:#15233b;">FocusFlow</p>
                                <h1 style="margin:0 0 12px;font-size:22px;font-weight:600;color:#15233b;">Your sign-in code</h1>
                                <p style="margin:0 0 24px;font-size:15px;line-height:24px;color:#58677d;">
                                    Hi {{displayName}}, use this code to finish signing in. It works for {{minutes}} minutes.
                                </p>
                                <p style="margin:0 0 24px;padding:16px;border-radius:8px;background:#f4f6fb;text-align:center;font-size:32px;font-weight:700;letter-spacing:8px;color:#15233b;font-variant-numeric:tabular-nums;">
                                    {{code}}
                                </p>
                                <p style="margin:0 0 32px;font-size:13px;line-height:20px;color:#58677d;">
                                    If you didn't try to sign in, you can ignore this email. Someone may know your password, so consider changing it.
                                </p>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </body>
</html>
