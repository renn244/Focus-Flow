# Copy to .env and fill in. Only MONGODB_URI and JWT_SECRET are required to run locally.

PORT=5000
SOFTWARE_ENV=development
CLIENT_BASE_URL=http://localhost:5173
# Public address of this API, used in links to uploaded files and the Discord callback.
PUBLIC_API_ORIGIN=http://localhost:5000

# Database (MongoDB Atlas or a local MongoDB)
MONGODB_URI=mongodb://localhost:27017/focusflow

# Any long random string. Signs sign-in tokens; changing it signs everyone out.
JWT_SECRET=change-me-to-a-long-random-string

# Email: confirmation, password reset and two-step sign-in codes.
# For Gmail use smtp.gmail.com, port 587 and an app password (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM="FocusFlow <you@gmail.com>"

# Optional: "Continue with GitHub"
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback-url

# Optional: Discord bot for project updates
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Defaults to PUBLIC_API_ORIGIN + /api/integrations/discord/callback
DISCORD_REDIRECT_URI=
# Time zone for the daily summary, e.g. Asia/Manila. Defaults to the server's.
DISCORD_SUMMARY_TIMEZONE=

# Optional: error reporting in production
SENTRY_DSN=
